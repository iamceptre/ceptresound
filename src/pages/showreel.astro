---
import Head from '../components/Head.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE_TITLE } from '../config'
---

<html lang="en">
    <Head title={SITE_TITLE} description="Showreel 2025 — Łukasz Brandeburg" />
    <body>
        <div class="main-wrapper">
            <Header />
            <main>
                <h1 class="visually-hidden">Showreel 2025 — Łukasz Brandeburg</h1>
                <video id="showreel-video" controls preload="metadata" class="responsive-video" playsinline width="1280" height="720">
                    <source src="/showreel-current.mp4" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    main {
        display: grid;
        place-content: center;
    }

    .responsive-video {
        width: 62vw;
        max-width: 100%;
        height: auto;
    }

    @media screen and (max-width: 60rem) {
        .responsive-video {
            width: 92vw;
        }
    }
</style>

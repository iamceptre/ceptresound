---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
    { href: '/showreel', label: 'Showreel' },
    { href: '/',         label: 'Home'     },
    { href: '/about',    label: 'About'    },
    { href: '/projects', label: 'Projects' },
];

import CopyToClipboard from './CopyToClipboard.astro'
---

<header>
    <div class="logo">
        <a href="https://linktr.ee/ceptre">
            <img src="/ceptre-logo.png" alt="ceptre logo" width="32" height="32" loading="eager" decoding="async" data-manual-fade />
        </a>
        <div>
            <span><a href="https://linktr.ee/ceptre" target="_blank" rel="noopener noreferrer">Łukasz Brandeburg</a></span>
            <span>Sound Designer | Music Producer & Artist </span>
        </div>
    </div>

    <input type="checkbox" id="menu-toggle" />
    <label for="menu-toggle" class="menu-button-wrapper" role="button" tabindex="0" aria-label="Toggle navigation" aria-expanded="false">
        <div class="menu-button"></div>
    </label>

    <nav>
        {navLinks.map(link => (
            <a
                href={link.href}
                class={currentPath === link.href ? 'active' : undefined}
                aria-current={currentPath === link.href ? 'page' : undefined}
            >
                {link.label}
            </a>
        ))}
    </nav>

    <div class="email-wrapper">
        <CopyToClipboard />
        <button class="theme-toggle" aria-label="Dark mode" aria-pressed="false">
            <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="5"/>
                <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
        </button>
    </div>
</header>
<hr>

<style>
    header {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
    }

    nav {
        display: flex;
        justify-content: center;
        gap: var(--size-500);
        align-items: center;
    }

    a {
        text-decoration: none;
        color: var(--cl-text);
    }

    .active {
        font-weight: 700;
    }

    .menu-button-wrapper {
        display: none;
        justify-content: flex-end;
        z-index: 60;
        cursor: pointer;
    }

    .menu-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1rem;
    }

    .menu-button::before,
    .menu-button::after {
        content: '';
        display: block;
        background-color: var(--cl-text);
        position: absolute;
        height: 2px;
        width: 1.25rem;
        transition: transform 0.15s;
    }

    .menu-button::before { margin-top: -8px; }
    .menu-button::after  { margin-top:  8px; }

    #menu-toggle:checked + .menu-button-wrapper .menu-button::before {
        margin-top: 0;
        transform: rotate(45deg);
    }
    #menu-toggle:checked + .menu-button-wrapper .menu-button::after {
        margin-top: 0;
        transform: rotate(-45deg);
    }

    .email-wrapper {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: var(--size-500);
    }

    .theme-toggle {
        display: flex;
        align-items: center;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--cl-text);
    }

    .theme-toggle:hover {
        color: var(--cl-grey-800);
    }

    /* Icon reflects the theme a click switches AWAY from: moon while light
       is active, sun while dark is active. Same system-or-override logic as
       the token blocks in global.css, resolved purely in CSS so the right
       icon shows even before JS runs. */
    .icon-sun { display: none; }

    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .icon-moon { display: none; }
        :global(:root:not([data-theme="light"])) .icon-sun  { display: block; }
    }

    :global(:root[data-theme="dark"]) .icon-moon { display: none; }
    :global(:root[data-theme="dark"]) .icon-sun  { display: block; }

    :global(:root[data-theme="light"]) .icon-moon { display: block; }
    :global(:root[data-theme="light"]) .icon-sun  { display: none; }

    .logo {
        display: flex;
        align-items: center;
        gap: var(--size-500);
    }

    .logo img {
        max-width: 2rem;
        height: 2rem;
    }

    /* The logo is a black glyph on transparency — flip it to white on dark. */
    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .logo img { filter: invert(1); }
    }

    :global(:root[data-theme="dark"]) .logo img { filter: invert(1); }

    .logo > div {
        display: flex;
        flex-direction: column;
    }

    .logo > div > span:nth-child(2) {
        color: var(--cl-grey-800);
        font-size: var(--size-300);
    }

    #menu-toggle { display: none; }

    @media screen and (max-width: 30rem) {
        .logo > div > span:nth-child(2) { display: none; }
    }

    @media screen and (max-width: 60rem) {
        header {
            grid-template-columns: 1fr min-content min-content;
            gap: 1rem;
        }

        nav {
            flex-direction: column;
            position: fixed;
            top: 0;
            right: -100%;
            width: 100%;
            height: 100%;
            background-color: var(--cl-bg);
            transition: right 0.15s ease;
            z-index: 50;
        }

        /* Hamburger stays at the outer edge, theme toggle beside it. */
        .menu-button-wrapper { display: block; order: 1; }

        #menu-toggle:checked ~ nav { right: 0; }

        /* Only the email hides on mobile (it moves to the footer) — the
           theme toggle inside the same wrapper stays. It has no z-index, so
           the fullscreen nav overlay (z-index 50) covers it while the menu
           is open; only the close button (z-index 60) stays on top. */
        .email-wrapper :global(.copy-email) { display: none; }
    }
</style>

<script>
    const isMobile = () => window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    const isSafari = () => navigator.userAgent.includes('Safari') && !navigator.userAgent.includes('Chrome');

    function setupMenu() {
        const checkbox = document.getElementById('menu-toggle') as HTMLInputElement | null;
        if (checkbox) checkbox.checked = false;
        document.documentElement.style.overflow = '';

        // The label toggles the checkbox on click natively, but labels aren't part of
        // the tab order — Enter/Space here makes the menu reachable by keyboard.
        const label = document.querySelector<HTMLElement>('.menu-button-wrapper');
        label?.addEventListener('keydown', (e) => {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault();
            if (!checkbox) return;
            checkbox.checked = !checkbox.checked;
            checkbox.dispatchEvent(new Event('change'));
        });

        checkbox?.addEventListener('change', () => {
            const open = checkbox.checked;
            label?.setAttribute('aria-expanded', String(open));
            document.documentElement.style.overflow = open ? 'hidden' : '';

            for (const v of document.getElementsByTagName('video')) {
                v.classList.toggle('zindex-video', open);
                const wrap = v.parentElement;
                if (wrap instanceof HTMLElement && getComputedStyle(wrap).position === 'relative') {
                    wrap.style.zIndex = open ? '-1' : '';
                }
            }

            if (!open) window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

    function setupThemeToggle() {
        const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
        if (!btn) return;

        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        const effective = () =>
            document.documentElement.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');

        // The static theme-color metas are media-query based, which a manual
        // override can't influence — keep them in sync from here instead.
        const apply = () => {
            const dark = effective() === 'dark';
            const bg = dark ? 'hsl(0, 0%, 8%)' : 'hsl(0, 0%, 92%)';
            document.querySelectorAll('meta[name="theme-color"]').forEach(m => m.setAttribute('content', bg));
            btn.setAttribute('aria-pressed', String(dark));
            const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
            btn.title = label;
            btn.setAttribute('aria-label', label);
        };
        apply();

        // Enables the 50ms crossfade (see .theme-transition in global.css) just
        // around the swap. The class must be present in the same style recalc as
        // the theme change for the transition to catch it, and is lifted again
        // once the fade is over so normal per-element transitions resume.
        let fadeTimer: ReturnType<typeof setTimeout>;
        const withCrossfade = (change: () => void) => {
            document.documentElement.classList.add('theme-transition');
            change();
            clearTimeout(fadeTimer);
            fadeTimer = setTimeout(() => document.documentElement.classList.remove('theme-transition'), 100);
        };

        btn.addEventListener('click', () => withCrossfade(() => {
            const next = effective() === 'dark' ? 'light' : 'dark';
            if ((next === 'dark') === systemDark.matches) {
                // Choosing what the system already prefers — drop the override
                // so the site goes back to following the OS setting live.
                delete document.documentElement.dataset.theme;
                try { localStorage.removeItem('theme'); } catch {}
            } else {
                document.documentElement.dataset.theme = next;
                try { localStorage.setItem('theme', next); } catch {}
            }
            apply();
        }));

        systemDark.addEventListener('change', () => withCrossfade(apply));
    }

    function setupKeyboardShortcuts() {
        if (isMobile()) return;

        // Clicking a native video control (e.g. fullscreen button) focuses the video's
        // UA shadow DOM. Blurring on the next frame prevents spacebar from re-activating
        // that control instead of being handled by our keydown listener.
        document.addEventListener('click', (e: MouseEvent) => {
            if (e.target instanceof HTMLVideoElement) {
                requestAnimationFrame(() => (e.target as HTMLVideoElement).blur());
            }
        });

        document.addEventListener('keydown', (e: KeyboardEvent) => {
            const isSpace = e.code === 'Space';
            const isF = e.key === 'f' || e.key === 'F';
            if (!isSpace && !isF) return;

            const tag = (document.activeElement as Element)?.tagName;
            if (tag === 'INPUT' || tag === 'TEXTAREA' || (isSpace && tag === 'BUTTON')) return;
            const video = document.querySelector<HTMLVideoElement>('video');
            if (!video) return;
            e.preventDefault();

            if (isSpace) {
                if (video.paused) {
                    const wrap = video.parentElement;
                    if (wrap instanceof HTMLElement && getComputedStyle(wrap).position === 'relative') {
                        const flash = document.createElement('div');
                        flash.setAttribute('aria-hidden', 'true');
                        flash.style.cssText =
                            'position:absolute;inset:0;background:white;pointer-events:none;' +
                            'animation:video-flash 200ms ease forwards;';
                        wrap.appendChild(flash);
                        flash.addEventListener('animationend', () => flash.remove(), { once: true });
                    }
                    video.play();
                } else {
                    video.pause();
                }
            } else if (document.fullscreenElement) {
                document.exitFullscreen();
            } else {
                video.style.visibility = 'visible';
                video.classList.add('visible');
                video.requestFullscreen();
            }
        });
    }

    function setupVideoThumbnails() {
        const videos = document.querySelectorAll<HTMLVideoElement>('video');

        if (isMobile() || isSafari()) {
            for (const video of videos) {
                video.closest('.video-shell')?.classList.add('video-live');
                requestAnimationFrame(() => video.classList.add('visible'));
            }
            return;
        }

        for (const video of videos) {

            // The black placeholder, play button and loading ring are all static
            // (.video-shell in global.css), visible from the first paint — this
            // script only adds interactivity on top, so a slow connection that
            // delays the JS bundle never delays the loading UI.
            const shell = video.closest<HTMLElement>('.video-shell');
            if (!shell) {
                video.classList.add('visible');
                continue;
            }

            video.style.visibility = 'hidden';

            const overlay = document.createElement('button');
            overlay.setAttribute('aria-label', 'Play video');
            overlay.style.cssText = 'position:absolute;inset:0;z-index:4;cursor:pointer;background:none;border:none;';
            shell.appendChild(overlay);

            let thumb: HTMLImageElement | null = null;
            let cleaned = false;

            const cleanup = () => {
                if (cleaned) return;
                cleaned = true;
                shell.classList.add('video-live');
                thumb?.remove();
                overlay.remove();
                video.style.visibility = 'visible';
                video.classList.add('visible');
            };

            video.addEventListener('play', cleanup, { once: true });

            overlay.addEventListener('click', (e) => {
                e.stopPropagation();

                const flash = document.createElement('div');
                flash.setAttribute('aria-hidden', 'true');
                flash.style.cssText =
                    'position:absolute;inset:0;z-index:5;background:white;pointer-events:none;' +
                    'animation:video-flash 200ms ease forwards;';
                shell.appendChild(flash);
                flash.addEventListener('animationend', () => flash.remove(), { once: true });

                video.play();
            }, { once: true });

            const build = () => {
                try {
                    const canvas = document.createElement('canvas');
                    canvas.width  = video.videoWidth  || 1280;
                    canvas.height = video.videoHeight || 720;
                    canvas.getContext('2d')!.drawImage(video, 0, 0);
                    video.currentTime = 0;

                    thumb = document.createElement('img');
                    thumb.src = canvas.toDataURL('image/jpeg', 0.8);
                    thumb.alt = '';
                    thumb.setAttribute('aria-hidden', 'true');
                    thumb.style.cssText =
                        'position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:cover;pointer-events:none;' +
                        'opacity:0;transition:opacity 200ms ease;';
                    shell.appendChild(thumb);
                    shell.classList.add('thumb-ready');

                    // thumb is brand new — never painted before — so a single rAF isn't
                    // enough to guarantee the browser painted its opacity:0 state before
                    // we flip it. The nested rAF waits one full extra frame, so the
                    // captured frame fades in behind the play button instead of popping.
                    requestAnimationFrame(() => requestAnimationFrame(() => {
                        if (thumb) thumb.style.opacity = '1';
                    }));
                } catch {
                    // Frame capture failed (e.g. tainted canvas) — the placeholder and
                    // play button still work without a thumbnail; just stop the ring.
                    shell.classList.add('thumb-ready');
                }
            };

            const showFallback = cleanup;

            const seekAndBuild = () => {
                // Seeking is what makes Chrome download the video — and it fetches the
                // whole file once asked to seek, regardless of how small the target is.
                video.currentTime = Math.min(video.duration * 0.1, 0.3);
                const seekTimeout = setTimeout(showFallback, 3000);
                video.addEventListener('seeked', () => {
                    clearTimeout(seekTimeout);
                    build();
                }, { once: true });
            };

            const startCapture = () => {
                if (cleaned) return;

                video.addEventListener('error', showFallback, { once: true });

                if (video.readyState >= 1) {
                    seekAndBuild();
                } else {
                    if (video.preload === 'none') video.preload = 'metadata';
                    const metaTimeout = setTimeout(showFallback, 5000);
                    video.addEventListener('loadedmetadata', () => {
                        clearTimeout(metaTimeout);
                        seekAndBuild();
                    }, { once: true });
                }
            };

            // The capture's seek triggers a full-file download, so hold it back
            // until (a) the page has fully loaded — text, fonts and images win
            // the bandwidth race — and (b) the video is actually near the
            // viewport, so below-the-fold videos cost nothing until scrolled to.
            // The static loading ring covers the wait; clicking play any time
            // just starts native playback.
            const whenIdle = (fn: () => void) => {
                if (document.readyState === 'complete') fn();
                else window.addEventListener('load', fn, { once: true });
            };

            whenIdle(() => {
                if (cleaned) return;
                if (!('IntersectionObserver' in window)) {
                    startCapture();
                    return;
                }
                const io = new IntersectionObserver((entries) => {
                    if (entries.some(e => e.isIntersecting)) {
                        io.disconnect();
                        startCapture();
                    }
                }, { rootMargin: '200px' });
                io.observe(shell);
                video.addEventListener('play', () => io.disconnect(), { once: true });
            });
        }
    }

    setupMenu();
    setupThemeToggle();
    setupKeyboardShortcuts();
    setupVideoThumbnails();
</script>

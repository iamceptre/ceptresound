---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../config';

export interface Props {
    title: string;
    description?: string | null;
    thumbnail?: string | null;
    heroImage?: string | null;
    heroImageWidth?: number;
    heroImageHeight?: number;
    video?: string | null;
    videoWidth?: number;
    videoHeight?: number;
    footerVideo?: string | null;
}

const { title, description, thumbnail, heroImage, heroImageWidth, heroImageHeight, video, videoWidth, videoHeight, footerVideo } = Astro.props;
---

<html lang="en">
    <Head title={`${title} / ${SITE_TITLE}`} description={description ?? undefined} image={thumbnail ?? undefined} preloadImage={heroImage ?? undefined} />
    <body>
        <div class="main-wrapper">
            <Header />
            <main>
                <div class="media-wrapper">
                    {heroImage && (
                        <img
                            class="hero-image"
                            src={heroImage}
                            width={heroImageWidth ?? 1280}
                            height={heroImageHeight ?? 720}
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                            alt=""
                        />
                    )}
                    {video && (
                        <div class="video-shell video">
                            <video
                                controls
                                preload="metadata"
                                playsinline
                                width={videoWidth ?? 1280}
                                height={videoHeight ?? 720}
                            >
                                <source src={video} type="video/mp4" />
                                Your browser does not support the video tag.
                            </video>
                        </div>
                    )}
                </div>
                <h1 class="title">{title}</h1>
                <hr />
                <slot />
                {footerVideo && (
                    <div class="video-shell footer-video">
                        <video
                            controls
                            preload="metadata"
                            playsinline
                            width={videoWidth ?? 1280}
                            height={videoHeight ?? 720}
                        >
                            <source src={footerVideo} type="video/mp4" />
                            Your browser does not support the video tag.
                        </video>
                    </div>
                )}
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    main {
        max-width: 38.2rem;
        margin-inline: auto;
    }

    .title {
        font-size: var(--size-700);
        margin-top: 1rem;
        text-align: center;
    }

    .media-wrapper {
        display: flex;
        justify-content: center;
    }

    .hero-image {
        width: 100%;
        height: auto;
        display: block;
    }

    .video,
    .footer-video {
        width: 100%;
        height: auto;
    }

    .footer-video {
        margin-top: 1rem;
    }

    :global(p)       { margin-bottom: 1rem; }
    :global(h2),
    :global(h3)      { margin-top: 1.5rem; margin-bottom: 0.5rem; font-weight: bold; color: var(--cl-grey-800); }
    :global(ul),
    :global(ol)      { padding-left: 1.5rem; margin-bottom: 1rem; }
    :global(li)      { margin-bottom: 0.5rem; }
    :global(a)       { text-decoration-style: solid; color: var(--cl-text); }
    :global(i)       { font-style: italic; color: var(--cl-grey-800); margin-bottom: 0.5rem; }
    :global(b)       { font-weight: 600; }
</style>
